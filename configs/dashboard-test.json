{
  "schema_version": 1,
  "platform": {
    "name": "microX dashboard-test",
    "description": "Assessment definition for the dashboard-test host."
  },
  "authorization": {
    "confirmed": true,
    "reference": "tests 192.168.1.81 mapped as dashboard-test"
  },
  "credentials": {},
  "assets": [
    {
      "id": "microx-dashboard",
      "host": "dashboard-test",
      "address": "192.168.1.81",
      "services": [
        {
          "id": "http-80",
          "protocol": "http",
          "port": 80,
          "base_path": "/dashboardSmartCity/",
          "enabled": true,
          "auth_only": false,
          "allow_state_changes": false,
          "notes": "HTTP service confirmed reachable. Root redirects to /dashboardSmartCity/, which redirects to the management area."
        },
        {
          "id": "https-443",
          "protocol": "https",
          "port": 443,
          "base_path": "/",
          "enabled": false,
          "auth_only": false,
          "allow_state_changes": false,
          "notes": "HTTPS port 443 was tested and refused the connection."
        }
      ]
    }
  ],
  "execution": {
    "orchestrator": "agentic",
    "mode": "balanced",
    "model": "snap4city",
    "max_rounds": 2,
    "require_ai": true,
    "allow_state_changes": false,
    "snap4city_credentials": "user_credentials.json"
  }
}