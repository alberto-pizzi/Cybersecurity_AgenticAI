{
  "schema_version": 1,
  "platform": {
    "name": "microX dashboard-test",
    "description": "Assessment definition for the dashboard-test host."
  },
  "authorization": {
    "confirmed": true,
    "reference": "tests 192.168.1.81 mapped as dashboard-test"
  },
  "credentials": {
    "dashboard_session": {
      "kind": "snap4city_oidc",
      "cookie_env": "DASHBOARD_TEST_COOKIE",
      "username_env": "DASHBOARD_TEST_USERNAME",
      "password_env": "DASHBOARD_TEST_PASSWORD",
      "login_path": "/dashboardSmartCity/",
      "validation_path": "/dashboardSmartCity/",
      "headless": true,
      "timeout_seconds": 60,
      "optional": true,
      "purpose": "Authorized Snap4City dashboard login. Existing cookie env overrides browser login; otherwise username/password env or interactive console input are used."
    }
  },
  "assets": [
    {
      "id": "microx-dashboard",
      "host": "dashboard-test",
      "address": "192.168.1.81",
      "services": [
        {
          "id": "http-80",
          "protocol": "http",
          "port": 80,
          "base_path": "/",
          "enabled": true,
          "auth_only": false,
          "allow_state_changes": false,
          "notes": "Enable this service only if curl/browser confirms that dashboard-test answers on HTTP port 80.",
          "credential_ref": "dashboard_session"
        },
        {
          "id": "https-443",
          "protocol": "https",
          "port": 443,
          "base_path": "/",
          "enabled": false,
          "auth_only": false,
          "allow_state_changes": false,
          "notes": "Enable this service only if curl/browser confirms that dashboard-test answers on HTTPS port 443.",
          "credential_ref": "dashboard_session"
        }
      ]
    }
  ],
  "execution": {
    "orchestrator": "agentic",
    "mode": "balanced",
    "model": "snap4city",
    "max_rounds": 2,
    "require_ai": true,
    "allow_state_changes": false,
    "snap4city_credentials": "snap4city_model_credentials.json"
  }
}
